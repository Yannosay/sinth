-- sinth:ui: the official Sinth component library.
-- Usage: import { Button, Card } from "sinth:ui"
-- Theme it by overriding the --ui-* custom properties on :root.

component Button(str variant = "primary", str size = "md", str? href, bool disabled = false, str type = "button", bool block = false) {
  if href {
    Link(class: ["ui-btn", "ui-btn--" + variant, "ui-btn--" + size, block ? "ui-btn--block" : ""], href: href, ariaDisabled: disabled ? "true" : null) {
      $slot
    }
  } else {
    Button(class: ["ui-btn", "ui-btn--" + variant, "ui-btn--" + size, block ? "ui-btn--block" : ""], type: type, disabled: disabled) {
      $slot
    }
  }
}

component Card(str? title, str? subtitle, bool interactive = false) {
  Article(class: ["ui-card", interactive ? "ui-card--interactive" : ""]) {
    if title {
      Header(class: "ui-card__header") {
        Heading(level: 3, class: "ui-card__title") { title }
        if subtitle {
          Paragraph(class: "ui-card__subtitle") { subtitle }
        }
      }
    }
    Div(class: "ui-card__body") {
      $slot
    }
    $slot(name: "footer")
  }
}

component Badge(str tone = "neutral") {
  Span(class: ["ui-badge", "ui-badge--" + tone]) {
    $slot
  }
}

component Alert(str tone = "info", str? title) {
  Div(class: ["ui-alert", "ui-alert--" + tone], role: tone == "danger" ? "alert" : "status") {
    if title {
      Strong(class: "ui-alert__title") { title }
    }
    Div(class: "ui-alert__body") {
      $slot
    }
  }
}

component Content(str width = "lg") {
  Div(class: ["ui-content", "ui-content--" + width]) {
    $slot
  }
}

component Columns(str min = "16rem", str gap = "1rem") {
  Div(class: "ui-columns", style: { gridTemplateColumns: "repeat(auto-fill, minmax(min(" + min + ", 100%), 1fr))", gap: gap }) {
    $slot
  }
}

component Inline(str gap = "0.5rem", str align = "center", str justify = "flex-start", bool wrap = true) {
  Div(class: "ui-inline", style: { gap: gap, alignItems: align, justifyContent: justify, flexWrap: wrap ? "wrap" : "nowrap" }) {
    $slot
  }
}

component VStack(str gap = "1rem", str align = "stretch") {
  Div(class: "ui-vstack", style: { gap: gap, alignItems: align }) {
    $slot
  }
}

component Field(str label, bind value, str type = "text", str placeholder = "", str? hint, str? error, bool required = false, str? name) {
  Label(class: ["ui-field", error ? "ui-field--invalid" : ""]) {
    Span(class: "ui-field__label") {
      label
      if required {
        Span(class: "ui-field__required", ariaHidden: "true") { " *" }
      }
    }
    if type == "textarea" {
      Textarea(class: "ui-field__control", model: value, placeholder: placeholder, required: required, name: name, ariaInvalid: error ? "true" : null)
    } else {
      Input(class: "ui-field__control", type: type, model: value, placeholder: placeholder, required: required, name: name, ariaInvalid: error ? "true" : null)
    }
    if error {
      Span(class: "ui-field__error") { error }
    } else if hint {
      Span(class: "ui-field__hint") { hint }
    }
  }
}

component Toggle(bind checked, str? label) {
  Label(class: "ui-toggle") {
    Input(type: "checkbox", role: "switch", class: "ui-toggle__input", model: checked)
    Span(class: "ui-toggle__track", ariaHidden: "true") {
      Span(class: "ui-toggle__thumb")
    }
    if label {
      Span(class: "ui-toggle__label") { label }
    }
  }
}

component Modal(bind open, str? title, str width = "32rem") {
  var obj dialog = null

  watch open {
    if open {
      setTimeout(() => dialog?.focus(), 0)
    }
  }

  if open transition("ui-fade") {
    Div(class: "ui-modal", onClick.self: open = false, onKeyDown.esc: open = false) {
      Div(class: "ui-modal__dialog", ref: dialog, role: "dialog", ariaModal: "true", ariaLabel: title, tabindex: "-1", style: { maxWidth: width }) {
        Header(class: "ui-modal__header") {
          if title {
            Heading(level: 2, class: "ui-modal__title") { title }
          }
          Button(class: "ui-modal__close", ariaLabel: "Close", onClick: open = false) { "×" }
        }
        Div(class: "ui-modal__body") {
          $slot
        }
        $slot(name: "footer")
      }
    }
  }
}

component Avatar(str name, str? src, str size = "2.5rem") {
  if src {
    Img(class: "ui-avatar", src: src, alt: name, style: { width: size, height: size })
  } else {
    Span(class: "ui-avatar ui-avatar--initials", title: name, style: { width: size, height: size }) {
      name.split(" ").map((part) => part.slice(0, 1)).join("").slice(0, 2).toUpperCase()
    }
  }
}

component Spinner(str size = "1.25rem", str label = "Loading") {
  Span(class: "ui-spinner", role: "status", ariaLabel: label, style: { width: size, height: size })
}

component Navbar(str? brand, str brandHref = "/") {
  Header(class: "ui-navbar") {
    Nav(class: "ui-navbar__inner") {
      if brand {
        Link(class: "ui-navbar__brand", href: brandHref) { brand }
      }
      $slot(name: "brand")
      Div(class: "ui-navbar__links") {
        $slot
      }
    }
  }
}

component Divider(str? label) {
  if label {
    Div(class: "ui-divider ui-divider--label", role: "separator") {
      Span { label }
    }
  } else {
    Hr(class: "ui-divider")
  }
}

style global {
  :root {
    --ui-bg: "#ffffff"
    --ui-surface: "#f7f7f8"
    --ui-surface-2: "#efeff1"
    --ui-text: "#0a0a0b"
    --ui-muted: "#5f5f6b"
    --ui-border: "#e3e3e8"
    --ui-accent: "#9333ea"
    --ui-accent-hover: "#7e22ce"
    --ui-accent-text: "#ffffff"
    --ui-success: "#15803d"
    --ui-warning: "#b45309"
    --ui-danger: "#dc2626"
    --ui-info: "#2563eb"
    --ui-radius: "10px"
    --ui-radius-lg: "16px"
    --ui-shadow: "0 1px 2px rgba(10, 10, 11, 0.06), 0 8px 24px rgba(10, 10, 11, 0.06)"
    --ui-font: "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
    --ui-mono: "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
    colorScheme: "light dark"
  }
  dark {
    :root {
      --ui-bg: "#0a0a0b"
      --ui-surface: "#141416"
      --ui-surface-2: "#1c1c20"
      --ui-text: "#f5f5f6"
      --ui-muted: "#a1a1aa"
      --ui-border: "#2a2a2f"
      --ui-accent: "#c084fc"
      --ui-accent-hover: "#d8b4fe"
      --ui-accent-text: "#0a0a0b"
      --ui-shadow: "0 1px 2px rgba(0, 0, 0, 0.4), 0 12px 32px rgba(0, 0, 0, 0.35)"
    }
  }
  *, *::before, *::after { boxSizing: "border-box" }
  body {
    margin: 0
    background: "var(--ui-bg)"
    color: "var(--ui-text)"
    fontFamily: "var(--ui-font)"
    lineHeight: "1.6"
    WebkitFontSmoothing: "antialiased"
  }
  img, svg, video { maxWidth: "100%" }
  a { color: "var(--ui-accent)" }
  :focus-visible { outline: "2px solid var(--ui-accent)"; outlineOffset: "2px" }

  .ui-btn {
    display: "inline-flex"
    alignItems: "center"
    justifyContent: "center"
    gap: "0.5rem"
    border: "1px solid transparent"
    borderRadius: "var(--ui-radius)"
    font: "inherit"
    fontWeight: "600"
    lineHeight: "1.2"
    textDecoration: "none"
    cursor: "pointer"
    transition: "background-color 0.15s, border-color 0.15s, color 0.15s, transform 0.05s"
    &:active { transform: "translateY(1px)" }
    &:disabled, &[aria-disabled="true"] { opacity: "0.5"; cursor: "not-allowed"; pointerEvents: "none" }
  }
  .ui-btn--sm { padding: "0.375rem 0.75rem"; fontSize: "0.875rem" }
  .ui-btn--md { padding: "0.625rem 1.125rem"; fontSize: "0.95rem" }
  .ui-btn--lg { padding: "0.8rem 1.5rem"; fontSize: "1.05rem" }
  .ui-btn--block { display: "flex"; width: "100%" }
  .ui-btn--primary { background: "var(--ui-accent)"; color: "var(--ui-accent-text)" }
  .ui-btn--primary:hover { background: "var(--ui-accent-hover)" }
  .ui-btn--secondary { background: "var(--ui-surface)"; color: "var(--ui-text)"; borderColor: "var(--ui-border)" }
  .ui-btn--secondary:hover { background: "var(--ui-surface-2)" }
  .ui-btn--ghost { background: "transparent"; color: "var(--ui-text)" }
  .ui-btn--ghost:hover { background: "var(--ui-surface)" }
  .ui-btn--danger { background: "var(--ui-danger)"; color: "#ffffff" }

  .ui-card {
    background: "var(--ui-surface)"
    border: "1px solid var(--ui-border)"
    borderRadius: "var(--ui-radius-lg)"
    padding: "1.25rem"
    display: "flex"
    flexDirection: "column"
    gap: "0.75rem"
  }
  .ui-card--interactive { transition: "transform 0.15s, box-shadow 0.15s" }
  .ui-card--interactive:hover { transform: "translateY(-2px)"; boxShadow: "var(--ui-shadow)" }
  .ui-card__title { margin: "0"; fontSize: "1.1rem" }
  .ui-card__subtitle { margin: "0.25rem 0 0"; color: "var(--ui-muted)"; fontSize: "0.9rem" }
  .ui-card__body > :first-child { marginTop: "0" }
  .ui-card__body > :last-child { marginBottom: "0" }

  .ui-badge {
    display: "inline-flex"
    alignItems: "center"
    padding: "0.125rem 0.6rem"
    borderRadius: "999px"
    fontSize: "0.78rem"
    fontWeight: "600"
    background: "var(--ui-surface-2)"
    color: "var(--ui-text)"
  }
  .ui-badge--accent { background: "color-mix(in srgb, var(--ui-accent) 18%, transparent)"; color: "var(--ui-accent)" }
  .ui-badge--success { background: "color-mix(in srgb, var(--ui-success) 16%, transparent)"; color: "var(--ui-success)" }
  .ui-badge--warning { background: "color-mix(in srgb, var(--ui-warning) 16%, transparent)"; color: "var(--ui-warning)" }
  .ui-badge--danger { background: "color-mix(in srgb, var(--ui-danger) 16%, transparent)"; color: "var(--ui-danger)" }

  .ui-alert {
    display: "flex"
    flexDirection: "column"
    gap: "0.25rem"
    padding: "0.875rem 1rem"
    borderRadius: "var(--ui-radius)"
    borderLeft: "4px solid var(--ui-info)"
    background: "color-mix(in srgb, var(--ui-info) 10%, var(--ui-bg))"
  }
  .ui-alert--success { borderLeftColor: "var(--ui-success)"; background: "color-mix(in srgb, var(--ui-success) 10%, var(--ui-bg))" }
  .ui-alert--warning { borderLeftColor: "var(--ui-warning)"; background: "color-mix(in srgb, var(--ui-warning) 10%, var(--ui-bg))" }
  .ui-alert--danger { borderLeftColor: "var(--ui-danger)"; background: "color-mix(in srgb, var(--ui-danger) 10%, var(--ui-bg))" }

  .ui-content { width: "100%"; marginInline: "auto"; paddingInline: "1.25rem" }
  .ui-content--sm { maxWidth: "40rem" }
  .ui-content--md { maxWidth: "56rem" }
  .ui-content--lg { maxWidth: "72rem" }
  .ui-content--full { maxWidth: "none" }
  .ui-columns { display: "grid" }
  .ui-inline { display: "flex" }
  .ui-vstack { display: "flex"; flexDirection: "column" }

  .ui-field { display: "flex"; flexDirection: "column"; gap: "0.375rem"; fontSize: "0.95rem" }
  .ui-field__label { fontWeight: "600" }
  .ui-field__required { color: "var(--ui-danger)" }
  .ui-field__control {
    font: "inherit"
    color: "inherit"
    padding: "0.6rem 0.75rem"
    borderRadius: "var(--ui-radius)"
    border: "1px solid var(--ui-border)"
    background: "var(--ui-bg)"
    transition: "border-color 0.15s, box-shadow 0.15s"
    &:focus { outline: "none"; borderColor: "var(--ui-accent)"; boxShadow: "0 0 0 3px color-mix(in srgb, var(--ui-accent) 25%, transparent)" }
  }
  textarea.ui-field__control { minHeight: "6rem"; resize: "vertical" }
  .ui-field--invalid .ui-field__control { borderColor: "var(--ui-danger)" }
  .ui-field__hint { color: "var(--ui-muted)"; fontSize: "0.85rem" }
  .ui-field__error { color: "var(--ui-danger)"; fontSize: "0.85rem" }

  .ui-toggle { display: "inline-flex"; alignItems: "center"; gap: "0.6rem"; cursor: "pointer"; position: "relative" }
  .ui-toggle__input { position: "absolute"; opacity: "0"; width: "1px"; height: "1px" }
  .ui-toggle__track {
    width: "2.5rem"
    height: "1.45rem"
    borderRadius: "999px"
    background: "var(--ui-surface-2)"
    border: "1px solid var(--ui-border)"
    position: "relative"
    transition: "background-color 0.15s"
  }
  .ui-toggle__thumb {
    position: "absolute"
    top: "2px"
    left: "2px"
    width: "1.1rem"
    height: "1.1rem"
    borderRadius: "50%"
    background: "var(--ui-text)"
    transition: "transform 0.15s"
  }
  .ui-toggle__input:checked + .ui-toggle__track { background: "var(--ui-accent)"; borderColor: "var(--ui-accent)" }
  .ui-toggle__input:checked + .ui-toggle__track .ui-toggle__thumb { transform: "translateX(1.05rem)"; background: "var(--ui-accent-text)" }
  .ui-toggle__input:focus-visible + .ui-toggle__track { outline: "2px solid var(--ui-accent)"; outlineOffset: "2px" }

  .ui-modal {
    position: "fixed"
    inset: "0"
    zIndex: "1000"
    display: "flex"
    alignItems: "center"
    justifyContent: "center"
    padding: "1rem"
    background: "rgba(10, 10, 11, 0.55)"
    backdropFilter: "blur(4px)"
    transition: "opacity 0.18s"
  }
  .ui-modal__dialog {
    width: "100%"
    background: "var(--ui-bg)"
    color: "var(--ui-text)"
    borderRadius: "var(--ui-radius-lg)"
    border: "1px solid var(--ui-border)"
    boxShadow: "var(--ui-shadow)"
    padding: "1.25rem"
    display: "flex"
    flexDirection: "column"
    gap: "1rem"
    maxHeight: "90vh"
    overflow: "auto"
  }
  .ui-modal__header { display: "flex"; alignItems: "center"; justifyContent: "space-between"; gap: "1rem" }
  .ui-modal__title { margin: "0"; fontSize: "1.2rem" }
  .ui-modal__close {
    border: "0"
    background: "transparent"
    color: "var(--ui-muted)"
    fontSize: "1.5rem"
    lineHeight: "1"
    cursor: "pointer"
    padding: "0.25rem 0.5rem"
    borderRadius: "var(--ui-radius)"
    marginLeft: "auto"
    &:hover { background: "var(--ui-surface)"; color: "var(--ui-text)" }
  }
  .ui-fade-enter, .ui-fade-leave { opacity: "0" }

  .ui-avatar { borderRadius: "50%"; objectFit: "cover"; flexShrink: "0" }
  .ui-avatar--initials {
    display: "inline-flex"
    alignItems: "center"
    justifyContent: "center"
    background: "color-mix(in srgb, var(--ui-accent) 20%, var(--ui-surface))"
    color: "var(--ui-accent)"
    fontWeight: "700"
    fontSize: "0.85em"
  }

  .ui-spinner {
    display: "inline-block"
    borderRadius: "50%"
    border: "2px solid var(--ui-border)"
    borderTopColor: "var(--ui-accent)"
    animation: "ui-spin 0.7s linear infinite"
  }
  @keyframes ui-spin { to { transform: "rotate(360deg)" } }
  reducedMotion {
    .ui-spinner { animationDuration: "2s" }
    .ui-btn, .ui-card--interactive, .ui-modal { transition: "none" }
  }

  .ui-navbar {
    position: "sticky"
    top: "0"
    zIndex: "100"
    background: "color-mix(in srgb, var(--ui-bg) 85%, transparent)"
    backdropFilter: "saturate(1.4) blur(10px)"
    borderBottom: "1px solid var(--ui-border)"
  }
  .ui-navbar__inner { maxWidth: "72rem"; margin: "0 auto"; padding: "0.75rem 1.25rem"; display: "flex"; alignItems: "center"; gap: "1.5rem" }
  .ui-navbar__brand { fontWeight: "800"; fontSize: "1.1rem"; color: "var(--ui-text)"; textDecoration: "none" }
  .ui-navbar__links { display: "flex"; alignItems: "center"; gap: "1rem"; marginLeft: "auto"; flexWrap: "wrap" }
  .ui-navbar__links a { color: "var(--ui-muted)"; textDecoration: "none"; fontWeight: "500" }
  .ui-navbar__links a:hover { color: "var(--ui-text)" }

  .ui-divider { border: "0"; borderTop: "1px solid var(--ui-border)"; margin: "1.5rem 0" }
  .ui-divider--label {
    display: "flex"
    alignItems: "center"
    gap: "0.75rem"
    color: "var(--ui-muted)"
    fontSize: "0.85rem"
    borderTop: "0"
    &::before, &::after { content: "''"; flex: "1"; borderTop: "1px solid var(--ui-border)" }
  }
}
