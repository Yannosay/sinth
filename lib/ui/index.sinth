-- sinth:ui: the official Sinth component library.
-- Usage: import { Button, Card, toast } from "sinth:ui"
-- Theme it by overriding the --ui-* custom properties on :root. Every component is keyboard
-- accessible and follows the WAI-ARIA patterns for its role.

-- Shared state: toasts are shown by the Toaster component, from anywhere that calls toast().
var obj[] toasts = []
var num toastSeq = 0

-- Shows a notification. tone: info, success, warning or danger. duration in ms (0 keeps it open).
function toast(str message, str tone = "info", num duration = 4000) {
  toastSeq += 1
  const id = toastSeq
  toasts.push({ id: id, message: message, tone: tone })
  if duration > 0 {
    setTimeout(() => dismissToast(id), duration)
  }
}

function dismissToast(num id) {
  const i = toasts.findIndex((t) => t.id == id)
  if i != -1 {
    toasts.splice(i, 1)
  }
}

function uiId(str prefix) -> str {
  return "ui-" + prefix + "-" + Math.random().toString(36).slice(2, 8)
}

component Button(str variant = "primary", str size = "md", str? href, bool disabled = false, str type = "button", bool block = false, bool loading = false) {
  if href {
    Link(class: ["ui-btn", "ui-btn--" + variant, "ui-btn--" + size, block ? "ui-btn--block" : ""], href: disabled ? null : href, ariaDisabled: disabled ? "true" : null) {
      $slot
    }
  } else {
    Button(class: ["ui-btn", "ui-btn--" + variant, "ui-btn--" + size, block ? "ui-btn--block" : ""], type: type, disabled: disabled or loading, ariaBusy: loading ? "true" : null) {
      if loading {
        Span(class: "ui-spinner ui-spinner--inline", ariaHidden: "true")
      }
      $slot
    }
  }
}

component Card(str? title, str? subtitle, bool interactive = false) {
  Article(class: ["ui-card", interactive ? "ui-card--interactive" : ""]) {
    if title {
      Header(class: "ui-card__header") {
        Heading(level: 3, class: "ui-card__title") { title }
        if subtitle {
          Paragraph(class: "ui-card__subtitle") { subtitle }
        }
      }
    }
    Div(class: "ui-card__body") {
      $slot
    }
    Footer(class: "ui-card__footer") {
      $slot(name: "footer")
    }
  }
}

component Badge(str tone = "neutral") {
  Span(class: ["ui-badge", "ui-badge--" + tone]) {
    $slot
  }
}

component Alert(str tone = "info", str? title) {
  Div(class: ["ui-alert", "ui-alert--" + tone], role: tone == "danger" ? "alert" : "status") {
    if title {
      Strong(class: "ui-alert__title") { title }
    }
    Div(class: "ui-alert__body") {
      $slot
    }
  }
}

component Content(str width = "lg") {
  Div(class: ["ui-content", "ui-content--" + width]) {
    $slot
  }
}

component Columns(str min = "16rem", str gap = "1rem") {
  Div(class: "ui-columns", style: { gridTemplateColumns: "repeat(auto-fill, minmax(min(" + min + ", 100%), 1fr))", gap: gap }) {
    $slot
  }
}

component Inline(str gap = "0.5rem", str align = "center", str justify = "flex-start", bool wrap = true) {
  Div(class: "ui-inline", style: { gap: gap, alignItems: align, justifyContent: justify, flexWrap: wrap ? "wrap" : "nowrap" }) {
    $slot
  }
}

component VStack(str gap = "1rem", str align = "stretch") {
  Div(class: "ui-vstack", style: { gap: gap, alignItems: align }) {
    $slot
  }
}

component Field(str label, bind value, str type = "text", str placeholder = "", str? hint, str? error, bool required = false, bool disabled = false, str? name, str? autocomplete) {
  const str id = uiId("field")
  Label(class: ["ui-field", error ? "ui-field--invalid" : ""]) {
    Span(class: "ui-field__label") {
      label
      if required {
        Span(class: "ui-field__required", ariaHidden: "true") { " *" }
      }
    }
    if type == "textarea" {
      Textarea(class: "ui-field__control", model: value, placeholder: placeholder, required: required, disabled: disabled, name: name, ariaInvalid: error ? "true" : null, ariaDescribedby: error or hint ? id : null)
    } else {
      Input(class: "ui-field__control", type: type, model: value, placeholder: placeholder, required: required, disabled: disabled, name: name, autocomplete: autocomplete, ariaInvalid: error ? "true" : null, ariaDescribedby: error or hint ? id : null)
    }
    if error {
      Span(class: "ui-field__error", id: id) { error }
    } else if hint {
      Span(class: "ui-field__hint", id: id) { hint }
    }
  }
}

-- options: strings, or objects with value and label.
component Select(str label, bind value, any[] options, str? placeholder, str? hint, str? error, bool required = false, bool disabled = false, str? name) {
  const str id = uiId("select")
  Label(class: ["ui-field", error ? "ui-field--invalid" : ""]) {
    Span(class: "ui-field__label") {
      label
      if required {
        Span(class: "ui-field__required", ariaHidden: "true") { " *" }
      }
    }
    Select(class: "ui-field__control", model: value, required: required, disabled: disabled, name: name, ariaInvalid: error ? "true" : null, ariaDescribedby: error or hint ? id : null) {
      if placeholder {
        Option(value: "", disabled: true) { placeholder }
      }
      for opt in options {
        Option(value: typeof opt == "object" ? opt.value : opt) { typeof opt == "object" ? opt.label : opt }
      }
    }
    if error {
      Span(class: "ui-field__error", id: id) { error }
    } else if hint {
      Span(class: "ui-field__hint", id: id) { hint }
    }
  }
}

component Toggle(bind checked, str? label, bool disabled = false) {
  Label(class: ["ui-toggle", disabled ? "ui-toggle--disabled" : ""]) {
    if label {
      Span(class: "ui-toggle__label") { label }
    }
    Input(type: "checkbox", role: "switch", class: "ui-toggle__input", model: checked, disabled: disabled)
    Span(class: "ui-toggle__track", ariaHidden: "true") {
      Span(class: "ui-toggle__thumb")
    }
  }
}

-- A modal dialog: traps focus while open, restores it on close, locks page scrolling and closes
-- with Escape or a backdrop click (dismissible: false keeps it open until the code closes it).
component Modal(bind open, str? title, str width = "32rem", bool dismissible = true) {
  var obj dialog = null
  var obj opener = null
  const str titleId = uiId("modal")

  function lock(bool on) {
    if on {
      opener = document.activeElement
      document.documentElement.style.overflow = "hidden"
      setTimeout(() => dialog?.focus(), 0)
    } else {
      document.documentElement.style.overflow = ""
      if opener and opener.isConnected {
        opener.focus()
      }
      opener = null
    }
  }

  function trapFocus(obj e) {
    const items = Array.from(dialog.querySelectorAll("a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex='-1'])"))
    if items.length == 0 {
      e.preventDefault()
      return
    }
    const first = items[0]
    const last = items[items.length - 1]
    if e.shiftKey and (document.activeElement == first or document.activeElement == dialog) {
      e.preventDefault()
      last.focus()
    } else if not e.shiftKey and document.activeElement == last {
      e.preventDefault()
      first.focus()
    }
  }

  function close() {
    if dismissible {
      open = false
    }
  }

  watch open { lock(open) }
  onMount { if open { lock(true) } }
  onDestroy { if open { document.documentElement.style.overflow = "" } }

  if open transition("ui-fade") {
    Div(class: "ui-modal", onClick.self: close(), onKeyDown.esc: close(), onKeyDown.tab: trapFocus(e)) {
      Div(class: "ui-modal__dialog", ref: dialog, role: "dialog", ariaModal: "true", ariaLabelledby: title ? titleId : null, tabindex: "-1", style: { maxWidth: width }) {
        Header(class: "ui-modal__header") {
          if title {
            Heading(level: 2, class: "ui-modal__title", id: titleId) { title }
          }
          if dismissible {
            Html.Button(class: "ui-close", type: "button", ariaLabel: "Close", onClick: open = false) { Svg(viewBox: "0 0 16 16", width: "16", height: "16", ariaHidden: "true") { Path(d: "M4 4l8 8M12 4l-8 8") } }
          }
        }
        Div(class: "ui-modal__body") {
          $slot
        }
        Footer(class: "ui-modal__footer") {
          $slot(name: "footer")
        }
      }
    }
  }
}

-- tabs: the tab labels. Put one Div per tab in the slot; only the selected one is shown.
-- Arrow keys, Home and End move between tabs (WAI-ARIA tabs pattern).
component Tabs(str[] tabs, bind selected = 0, str? label) {
  var obj list = null
  const str id = uiId("tabs")

  function pick(num i) {
    selected = (i + tabs.length) % tabs.length
    setTimeout(() => list?.querySelectorAll("[role=tab]")[selected]?.focus(), 0)
  }

  Div(class: "ui-tabs") {
    Div(class: "ui-tabs__list", role: "tablist", ariaLabel: label, ref: list,
        onKeyDown.right: pick(selected + 1), onKeyDown.left: pick(selected - 1),
        onKeyDown.home: pick(0), onKeyDown.end: pick(tabs.length - 1)) {
      for tab, i in tabs {
        Html.Button(type: "button", class: "ui-tabs__tab", role: "tab", id: id + "-tab-" + i, ariaSelected: selected == i ? "true" : "false",
               ariaControls: id + "-panel", tabindex: selected == i ? "0" : "-1", onClick: selected = i) { tab }
      }
    }
    Div(class: "ui-tabs__panel", role: "tabpanel", id: id + "-panel", ariaLabelledby: id + "-tab-" + selected, tabindex: "0", dataSelected: selected) {
      $slot
    }
  }
}

-- A disclosure built on <details>: works without JavaScript and with find-in-page.
component Accordion(str title, bool open = false) {
  Details(class: "ui-accordion", open: open) {
    Summary(class: "ui-accordion__summary") { title }
    Div(class: "ui-accordion__body") {
      $slot
    }
  }
}

component Tooltip(str text, str placement = "top") {
  const str id = uiId("tip")
  Span(class: ["ui-tooltip", "ui-tooltip--" + placement], ariaDescribedby: id) {
    $slot
    Span(class: "ui-tooltip__bubble", role: "tooltip", id: id) { text }
  }
}

-- columns: objects with key and label (optional: align "end" for numbers).
-- rows: objects; set sortable to sort by clicking a header.
component Table(obj[] columns, obj[] rows, str? caption, bool sortable = false, str empty = "No data", bool striped = true) {
  var str sortKey = ""
  var num sortDir = 1
  computed obj[] sorted = sortKey == "" ? rows : rows.slice().sort((a, b) => (a[sortKey] > b[sortKey] ? 1 : a[sortKey] < b[sortKey] ? -1 : 0) * sortDir)

  function sortBy(str key) {
    if sortKey == key {
      sortDir = -sortDir
    } else {
      sortKey = key
      sortDir = 1
    }
  }

  Div(class: "ui-table__wrap", tabindex: "0", role: "region", ariaLabel: caption) {
    Table(class: ["ui-table", striped ? "ui-table--striped" : ""]) {
      if caption {
        Caption(class: "ui-table__caption") { caption }
      }
      Thead {
        Tr {
          for col in columns {
            Th(scope: "col", class: col.align == "end" ? "ui-table__num" : "", ariaSort: sortKey == col.key ? (sortDir == 1 ? "ascending" : "descending") : null) {
              if sortable {
                Html.Button(type: "button", class: "ui-table__sort", onClick: sortBy(col.key)) {
                  col.label
                  Span(class: ["ui-table__arrow", sortKey == col.key ? "ui-table__arrow--on" : "", sortDir == -1 ? "ui-table__arrow--desc" : ""], ariaHidden: "true")
                }
              } else {
                col.label
              }
            }
          }
        }
      }
      Tbody {
        for row in sorted {
          Tr {
            for col in columns {
              Td(class: col.align == "end" ? "ui-table__num" : "") { row[col.key] }
            }
          }
        } else {
          Tr {
            Td(class: "ui-table__empty", colspan: columns.length) { empty }
          }
        }
      }
    }
  }
}

-- page is 1-based. Shows first, last and the pages around the current one.
component Pagination(bind page, num total, str label = "Pagination") {
  computed num[] pages = range(1, total + 1).filter((p) => p == 1 or p == total or Math.abs(p - page) <= 1)

  Nav(class: "ui-pagination", ariaLabel: label) {
    Html.Button(type: "button", class: "ui-pagination__item", disabled: page <= 1, ariaLabel: "Previous page", onClick: page -= 1) { Svg(viewBox: "0 0 16 16", width: "14", height: "14", ariaHidden: "true") { Path(d: "M10 4l-4 4 4 4") } }
    for p, i in pages {
      if i > 0 and p - pages[i - 1] > 1 {
        Span(class: "ui-pagination__gap", ariaHidden: "true") { "…" }
      }
      Html.Button(type: "button", class: "ui-pagination__item", ariaCurrent: p == page ? "page" : null, onClick: page = p) { p }
    }
    Html.Button(type: "button", class: "ui-pagination__item", disabled: page >= total, ariaLabel: "Next page", onClick: page += 1) { Svg(viewBox: "0 0 16 16", width: "14", height: "14", ariaHidden: "true") { Path(d: "M6 4l4 4-4 4") } }
  }
}

-- items: objects with label and an optional href (the last item is the current page).
component Breadcrumbs(obj[] items) {
  Nav(class: "ui-breadcrumbs", ariaLabel: "Breadcrumb") {
    Ol {
      for item, i in items {
        Li {
          if item.href and i < items.length - 1 {
            Link(href: item.href) { item.label }
          } else {
            Span(ariaCurrent: i == items.length - 1 ? "page" : null) { item.label }
          }
        }
      }
    }
  }
}

-- value from 0 to max; leave it out for an indeterminate bar.
component ProgressBar(num? value, num max = 100, str label = "Progress") {
  Div(class: ["ui-progress", value == null ? "ui-progress--indeterminate" : ""], role: "progressbar", ariaLabel: label,
      ariaValuemin: "0", ariaValuemax: max, ariaValuenow: value) {
    Div(class: "ui-progress__bar", style: { width: value == null ? "40%" : Math.min(100, Math.max(0, value / max * 100)) + "%" })
  }
}

component Skeleton(str width = "100%", str height = "1rem", str radius = "var(--ui-radius)") {
  Span(class: "ui-skeleton", ariaHidden: "true", style: { width: width, height: height, borderRadius: radius })
}

component EmptyState(str title, str? description) {
  Div(class: "ui-empty") {
    Strong(class: "ui-empty__title") { title }
    if description {
      Paragraph(class: "ui-empty__description") { description }
    }
    $slot
  }
}

-- A dropdown menu: the slot holds the items (Button or Link elements). Closes on Escape,
-- outside clicks and after an item is chosen.
component Dropdown(str label, str variant = "secondary", str align = "start") {
  var bool open = false
  var obj root = null

  function toggle() {
    open = not open
    if open {
      setTimeout(() => root?.querySelector(".ui-dropdown__menu a, .ui-dropdown__menu button")?.focus(), 0)
    }
  }

  function move(obj e, num dir) {
    const items = Array.from(root.querySelectorAll(".ui-dropdown__menu a, .ui-dropdown__menu button"))
    if items.length == 0 {
      return
    }
    e.preventDefault()
    const i = items.indexOf(document.activeElement)
    items[(i + dir + items.length) % items.length].focus()
  }

  function closeAndFocus() {
    open = false
    root?.querySelector(".ui-dropdown__trigger")?.focus()
  }

  onMount {
    const away = (e) => {
      if open and root and not root.contains(e.target) {
        open = false
      }
    }
    document.addEventListener("click", away)
    return () => document.removeEventListener("click", away)
  }

  Div(class: "ui-dropdown", ref: root, onKeyDown.esc: closeAndFocus(), onKeyDown.down: move(e, 1), onKeyDown.up: move(e, -1)) {
    Html.Button(type: "button", class: ["ui-btn", "ui-btn--" + variant, "ui-btn--md", "ui-dropdown__trigger"], ariaHaspopup: "menu", ariaExpanded: open ? "true" : "false", onClick: toggle()) {
      label
      Svg(class: "ui-dropdown__caret", viewBox: "0 0 16 16", width: "12", height: "12", ariaHidden: "true") { Path(d: "M4 6l4 4 4-4") }
    }
    if open {
      Div(class: ["ui-dropdown__menu", "ui-dropdown__menu--" + align], role: "menu", onClick: open = false) {
        $slot
      }
    }
  }
}

-- Renders the notifications created with toast(). Place it once, for example at the end of a layout.
component Toaster(str position = "bottom-end") {
  Div(class: ["ui-toaster", "ui-toaster--" + position], role: "region", ariaLabel: "Notifications", ariaLive: "polite") {
    for t in toasts key t.id {
      Div(class: ["ui-toast", "ui-toast--" + t.tone], role: t.tone == "danger" ? "alert" : "status") {
        Span(class: "ui-toast__dot", ariaHidden: "true")
        Span(class: "ui-toast__message") { t.message }
        Html.Button(class: "ui-close ui-toast__close", type: "button", ariaLabel: "Dismiss", onClick: dismissToast(t.id)) { Svg(viewBox: "0 0 16 16", width: "16", height: "16", ariaHidden: "true") { Path(d: "M4 4l8 8M12 4l-8 8") } }
      }
    }
  }
}

component Kbd() {
  Kbd(class: "ui-kbd") {
    $slot
  }
}

component Avatar(str name, str? src, str size = "2.5rem") {
  if src {
    Img(class: "ui-avatar", src: src, alt: name, style: { width: size, height: size })
  } else {
    Span(class: "ui-avatar ui-avatar--initials", role: "img", ariaLabel: name, title: name, style: { width: size, height: size }) {
      name.split(" ").map((part) => part.slice(0, 1)).join("").slice(0, 2).toUpperCase()
    }
  }
}

component Spinner(str size = "1.25rem", str label = "Loading") {
  Span(class: "ui-spinner", role: "status", ariaLabel: label, style: { width: size, height: size })
}

component Navbar(str? brand, str brandHref = "/") {
  Header(class: "ui-navbar") {
    Nav(class: "ui-navbar__inner") {
      if brand {
        Link(class: "ui-navbar__brand", href: brandHref) { brand }
      }
      $slot(name: "brand")
      Div(class: "ui-navbar__links") {
        $slot
      }
    }
  }
}

component Divider(str? label) {
  if label {
    Div(class: "ui-divider ui-divider--label", role: "separator") {
      Span { label }
    }
  } else {
    Hr(class: "ui-divider")
  }
}


-- Base styles and theme. In a form every control gets its own row and buttons line up side by side.
style global {
  :root {
    --ui-bg: "#ffffff"
    --ui-surface: "#f6f6f8"
    --ui-surface-2: "#ececf0"
    --ui-elevated: "#ffffff"
    --ui-text: "#0a0a0b"
    --ui-muted: "#6b6b76"
    --ui-border: "#e4e4e9"
    --ui-border-strong: "#d2d2d9"
    --ui-accent: "#7c3aed"
    --ui-accent-hover: "#6d28d9"
    --ui-accent-text: "#ffffff"
    --ui-success: "#16a34a"
    --ui-warning: "#d97706"
    --ui-danger: "#dc2626"
    --ui-info: "#2563eb"
    --ui-radius: "10px"
    --ui-radius-lg: "16px"
    --ui-control: "2.5rem"
    --ui-ring: "0 0 0 3px color-mix(in srgb, var(--ui-accent) 28%, transparent)"
    --ui-shadow: "0 1px 2px rgba(10, 10, 11, 0.05), 0 4px 16px rgba(10, 10, 11, 0.06)"
    --ui-shadow-lg: "0 2px 6px rgba(10, 10, 11, 0.06), 0 24px 64px rgba(10, 10, 11, 0.16)"
    --ui-font: "-apple-system, BlinkMacSystemFont, 'Segoe UI Variable Text', 'Segoe UI', system-ui, Roboto, 'Helvetica Neue', Arial, sans-serif"
    --ui-mono: "ui-monospace, 'SF Mono', SFMono-Regular, Menlo, Consolas, monospace"
    --ui-ease: "cubic-bezier(0.2, 0, 0, 1)"
    colorScheme: "light dark"
  }
  dark {
    :root {
      --ui-bg: "#0a0a0b"
      --ui-surface: "#141417"
      --ui-surface-2: "#1d1d22"
      --ui-elevated: "#18181c"
      --ui-text: "#f5f5f6"
      --ui-muted: "#a1a1aa"
      --ui-border: "rgba(255, 255, 255, 0.09)"
      --ui-border-strong: "rgba(255, 255, 255, 0.16)"
      --ui-accent: "#a78bfa"
      --ui-accent-hover: "#c4b5fd"
      --ui-accent-text: "#0a0a0b"
      --ui-success: "#4ade80"
      --ui-warning: "#fbbf24"
      --ui-danger: "#f87171"
      --ui-info: "#60a5fa"
      --ui-shadow: "0 1px 2px rgba(0, 0, 0, 0.5), 0 4px 16px rgba(0, 0, 0, 0.3)"
      --ui-shadow-lg: "0 2px 6px rgba(0, 0, 0, 0.5), 0 24px 64px rgba(0, 0, 0, 0.55)"
    }
  }

  *, *::before, *::after { boxSizing: "border-box" }
  body {
    margin: 0
    background: "var(--ui-bg)"
    color: "var(--ui-text)"
    fontFamily: "var(--ui-font)"
    fontSize: "1rem"
    lineHeight: "1.6"
    WebkitFontSmoothing: "antialiased"
    textRendering: "optimizeLegibility"
  }
  :where(h1, h2, h3, h4) { lineHeight: "1.2"; letterSpacing: "-0.02em"; fontWeight: "700"; margin: "0 0 0.5em" }
  :where(h1) { fontSize: "clamp(2rem, 1.6rem + 1.5vw, 2.6rem)"; letterSpacing: "-0.03em" }
  :where(h2) { fontSize: "1.5rem"; marginTop: "1.6em" }
  :where(h3) { fontSize: "1.15rem" }
  :where(p) { margin: "0 0 1em" }
  :where(img, svg, video) { maxWidth: "100%" }
  :where(a) { color: "var(--ui-accent)"; textUnderlineOffset: "0.18em" }
  :where(code) { fontFamily: "var(--ui-mono)"; fontSize: "0.9em" }
  :focus-visible { outline: "2px solid var(--ui-accent)"; outlineOffset: "2px" }
  ::selection { background: "color-mix(in srgb, var(--ui-accent) 30%, transparent)" }

  :where(form) { display: "flex"; flexWrap: "wrap"; alignItems: "center"; gap: "1.1rem 0.5rem" }
  :where(form) > :where(:not(button, .ui-btn, .ui-dropdown, .ui-spinner)) { flex: "1 0 100%"; minWidth: "0" }

  .ui-btn {
    display: "inline-flex"
    alignItems: "center"
    justifyContent: "center"
    gap: "0.5rem"
    height: "var(--ui-control)"
    padding: "0 1rem"
    border: "1px solid transparent"
    borderRadius: "var(--ui-radius)"
    font: "inherit"
    fontSize: "0.94rem"
    fontWeight: "550"
    lineHeight: "1"
    letterSpacing: "-0.005em"
    whiteSpace: "nowrap"
    textDecoration: "none"
    cursor: "pointer"
    userSelect: "none"
    transition: "background-color 0.15s var(--ui-ease), border-color 0.15s var(--ui-ease), color 0.15s var(--ui-ease), box-shadow 0.15s var(--ui-ease), transform 0.1s var(--ui-ease)"
    &:active { transform: "scale(0.98)" }
    &:focus-visible { outline: "none"; boxShadow: "var(--ui-ring)" }
    &:disabled, &[aria-disabled="true"] { opacity: "0.45"; cursor: "not-allowed"; pointerEvents: "none" }
    &[aria-busy="true"] { cursor: "progress" }
  }
  .ui-btn--sm { height: "2rem"; padding: "0 0.75rem"; fontSize: "0.85rem"; borderRadius: "8px" }
  .ui-btn--lg { height: "3rem"; padding: "0 1.4rem"; fontSize: "1rem"; borderRadius: "12px" }
  .ui-btn--block { display: "flex"; width: "100%" }
  .ui-btn--primary { background: "var(--ui-accent)"; color: "var(--ui-accent-text)"; boxShadow: "inset 0 1px 0 rgba(255, 255, 255, 0.14)" }
  .ui-btn--primary:hover { background: "var(--ui-accent-hover)" }
  .ui-btn--secondary { background: "var(--ui-surface)"; color: "var(--ui-text)"; borderColor: "var(--ui-border)" }
  .ui-btn--secondary:hover { background: "var(--ui-surface-2)"; borderColor: "var(--ui-border-strong)" }
  .ui-btn--ghost { background: "transparent"; color: "var(--ui-text)" }
  .ui-btn--ghost:hover { background: "var(--ui-surface)" }
  .ui-btn--danger { background: "color-mix(in srgb, var(--ui-danger) 12%, transparent)"; color: "var(--ui-danger)"; borderColor: "color-mix(in srgb, var(--ui-danger) 30%, transparent)" }
  .ui-btn--danger:hover { background: "var(--ui-danger)"; color: "#ffffff"; borderColor: "var(--ui-danger)" }

  .ui-close {
    display: "inline-flex"
    alignItems: "center"
    justifyContent: "center"
    width: "2rem"
    height: "2rem"
    flexShrink: "0"
    marginLeft: "auto"
    border: "0"
    borderRadius: "8px"
    background: "transparent"
    color: "var(--ui-muted)"
    cursor: "pointer"
    transition: "background-color 0.15s, color 0.15s"
    &:hover { background: "var(--ui-surface-2)"; color: "var(--ui-text)" }
    & svg { fill: "none"; stroke: "currentColor"; strokeWidth: "1.6"; strokeLinecap: "round" }
  }

  .ui-card {
    display: "flex"
    flexDirection: "column"
    gap: "0.9rem"
    padding: "1.4rem"
    background: "var(--ui-elevated)"
    border: "1px solid var(--ui-border)"
    borderRadius: "var(--ui-radius-lg)"
    boxShadow: "var(--ui-shadow)"
  }
  .ui-card--interactive { transition: "transform 0.2s var(--ui-ease), box-shadow 0.2s var(--ui-ease), border-color 0.2s" }
  .ui-card--interactive:hover { transform: "translateY(-2px)"; boxShadow: "var(--ui-shadow-lg)"; borderColor: "var(--ui-border-strong)" }
  .ui-card__title { margin: "0"; fontSize: "1.05rem"; fontWeight: "650"; letterSpacing: "-0.01em" }
  .ui-card__subtitle { margin: "0.2rem 0 0"; color: "var(--ui-muted)"; fontSize: "0.9rem" }
  .ui-card__body > :first-child { marginTop: "0" }
  .ui-card__body > :last-child { marginBottom: "0" }
  .ui-card__footer, .ui-modal__footer { display: "flex"; flexWrap: "wrap"; justifyContent: "flex-end"; gap: "0.5rem" }
  .ui-card__footer:empty, .ui-modal__footer:empty { display: "none" }
  .ui-card__footer { paddingTop: "0.9rem"; borderTop: "1px solid var(--ui-border)" }

  .ui-badge {
    display: "inline-flex"
    alignItems: "center"
    gap: "0.35rem"
    height: "1.4rem"
    padding: "0 0.55rem"
    borderRadius: "999px"
    fontSize: "0.75rem"
    fontWeight: "600"
    lineHeight: "1"
    background: "var(--ui-surface-2)"
    color: "var(--ui-text)"
  }
  .ui-badge--accent { background: "color-mix(in srgb, var(--ui-accent) 15%, transparent)"; color: "var(--ui-accent)" }
  .ui-badge--success { background: "color-mix(in srgb, var(--ui-success) 15%, transparent)"; color: "var(--ui-success)" }
  .ui-badge--warning { background: "color-mix(in srgb, var(--ui-warning) 15%, transparent)"; color: "var(--ui-warning)" }
  .ui-badge--danger { background: "color-mix(in srgb, var(--ui-danger) 15%, transparent)"; color: "var(--ui-danger)" }

  .ui-alert {
    --ui-tone: "var(--ui-info)"
    display: "flex"
    flexDirection: "column"
    gap: "0.2rem"
    padding: "0.9rem 1rem 0.9rem 2.4rem"
    position: "relative"
    borderRadius: "var(--ui-radius)"
    border: "1px solid color-mix(in srgb, var(--ui-tone) 28%, transparent)"
    background: "color-mix(in srgb, var(--ui-tone) 8%, var(--ui-bg))"
    fontSize: "0.94rem"
    &::before { content: "''"; position: "absolute"; left: "1rem"; top: "1.35rem"; width: "0.5rem"; height: "0.5rem"; borderRadius: "50%"; background: "var(--ui-tone)"; transform: "translateY(-50%)" }
  }
  .ui-alert--success { --ui-tone: "var(--ui-success)" }
  .ui-alert--warning { --ui-tone: "var(--ui-warning)" }
  .ui-alert--danger { --ui-tone: "var(--ui-danger)" }
  .ui-alert__title { fontWeight: "650" }
  .ui-alert__body { color: "color-mix(in srgb, var(--ui-text) 82%, transparent)" }
  .ui-alert__body > :last-child { marginBottom: "0" }

  .ui-content { display: "flex"; flexDirection: "column"; gap: "1.25rem"; width: "100%"; marginInline: "auto"; paddingInline: "clamp(1rem, 4vw, 2rem)"; paddingBlock: "clamp(1.5rem, 5vw, 3rem)" }
  .ui-content > :where(h1, h2, h3, h4, p, ul, ol) { margin: "0" }
  .ui-content > :where(h2, h3) { marginTop: "0.75rem" }
  .ui-content > .ui-divider { margin: "0.5rem 0" }
  .ui-content--sm { maxWidth: "40rem" }
  .ui-content--md { maxWidth: "56rem" }
  .ui-content--lg { maxWidth: "72rem" }
  .ui-content--full { maxWidth: "none" }
  .ui-columns { display: "grid" }
  .ui-inline { display: "flex" }
  .ui-vstack { display: "flex"; flexDirection: "column" }

  .ui-field { display: "flex"; flexDirection: "column"; gap: "0.4rem"; minWidth: "0"; fontSize: "0.94rem" }
  .ui-field__label { fontSize: "0.875rem"; fontWeight: "550"; color: "var(--ui-text)" }
  .ui-field__required { color: "var(--ui-danger)" }
  .ui-field__control {
    width: "100%"
    minHeight: "var(--ui-control)"
    padding: "0 0.8rem"
    font: "inherit"
    color: "inherit"
    background: "var(--ui-bg)"
    border: "1px solid var(--ui-border-strong)"
    borderRadius: "var(--ui-radius)"
    transition: "border-color 0.15s var(--ui-ease), box-shadow 0.15s var(--ui-ease)"
    &::placeholder { color: "color-mix(in srgb, var(--ui-muted) 75%, transparent)" }
    &:hover:not(:disabled) { borderColor: "color-mix(in srgb, var(--ui-text) 30%, transparent)" }
    &:focus { outline: "none"; borderColor: "var(--ui-accent)"; boxShadow: "var(--ui-ring)" }
    &:disabled { opacity: "0.55"; cursor: "not-allowed"; background: "var(--ui-surface)" }
  }
  textarea.ui-field__control { minHeight: "6.5rem"; padding: "0.6rem 0.8rem"; resize: "vertical"; lineHeight: "1.5" }
  select.ui-field__control {
    appearance: "none"
    paddingRight: "2.4rem"
    cursor: "pointer"
    backgroundImage: "linear-gradient(45deg, transparent 50%, var(--ui-muted) 50%), linear-gradient(135deg, var(--ui-muted) 50%, transparent 50%)"
    backgroundPosition: "calc(100% - 1.15rem) 55%, calc(100% - 0.85rem) 55%"
    backgroundSize: "0.3rem 0.3rem"
    backgroundRepeat: "no-repeat"
  }
  .ui-field--invalid .ui-field__control { borderColor: "var(--ui-danger)" }
  .ui-field--invalid .ui-field__control:focus { boxShadow: "0 0 0 3px color-mix(in srgb, var(--ui-danger) 25%, transparent)" }
  .ui-field__hint { color: "var(--ui-muted)"; fontSize: "0.84rem" }
  .ui-field__error { color: "var(--ui-danger)"; fontSize: "0.84rem" }

  .ui-toggle { display: "inline-flex"; alignItems: "center"; justifyContent: "space-between"; gap: "0.85rem"; minHeight: "var(--ui-control)"; cursor: "pointer"; position: "relative"; fontSize: "0.94rem" }
  .ui-toggle--disabled { opacity: "0.5"; cursor: "not-allowed" }
  .ui-toggle__input { position: "absolute"; opacity: "0"; width: "1px"; height: "1px"; margin: "0" }
  .ui-toggle__track {
    flexShrink: "0"
    position: "relative"
    width: "2.75rem"
    height: "1.625rem"
    borderRadius: "999px"
    background: "color-mix(in srgb, var(--ui-text) 16%, transparent)"
    transition: "background-color 0.2s var(--ui-ease)"
  }
  .ui-toggle__thumb {
    position: "absolute"
    top: "0.125rem"
    left: "0.125rem"
    width: "1.375rem"
    height: "1.375rem"
    borderRadius: "50%"
    background: "#ffffff"
    boxShadow: "0 1px 3px rgba(0, 0, 0, 0.25), 0 1px 1px rgba(0, 0, 0, 0.08)"
    transition: "transform 0.22s var(--ui-ease)"
  }
  .ui-toggle__input:checked + .ui-toggle__track { background: "var(--ui-accent)" }
  .ui-toggle__input:checked + .ui-toggle__track .ui-toggle__thumb { transform: "translateX(1.125rem)" }
  .ui-toggle__input:focus-visible + .ui-toggle__track { boxShadow: "var(--ui-ring)" }
  .ui-toggle:active .ui-toggle__thumb { width: "1.6rem" }
  .ui-toggle:active .ui-toggle__input:checked + .ui-toggle__track .ui-toggle__thumb { transform: "translateX(0.9rem)" }

  .ui-modal {
    position: "fixed"
    inset: "0"
    zIndex: "1000"
    display: "flex"
    alignItems: "center"
    justifyContent: "center"
    padding: "1rem"
    background: "rgba(10, 10, 11, 0.45)"
    backdropFilter: "blur(6px)"
    transition: "opacity 0.2s var(--ui-ease)"
  }
  .ui-modal__dialog {
    width: "100%"
    maxHeight: "min(90vh, 48rem)"
    overflow: "auto"
    display: "flex"
    flexDirection: "column"
    gap: "1rem"
    padding: "1.5rem"
    background: "var(--ui-elevated)"
    color: "var(--ui-text)"
    border: "1px solid var(--ui-border)"
    borderRadius: "20px"
    boxShadow: "var(--ui-shadow-lg)"
    transition: "transform 0.2s var(--ui-ease)"
    &:focus { outline: "none" }
  }
  .ui-modal__header { display: "flex"; alignItems: "center"; gap: "1rem"; margin: "-0.35rem -0.5rem 0 0" }
  .ui-modal__title { margin: "0"; fontSize: "1.15rem"; fontWeight: "650"; letterSpacing: "-0.015em" }
  .ui-modal__body { color: "color-mix(in srgb, var(--ui-text) 85%, transparent)" }
  .ui-modal__body > :last-child { marginBottom: "0" }
  .ui-modal__footer { marginTop: "0.25rem" }
  .ui-fade-enter, .ui-fade-leave { opacity: "0" }
  .ui-fade-enter .ui-modal__dialog, .ui-fade-leave .ui-modal__dialog { transform: "scale(0.96) translateY(6px)" }

  .ui-tabs__list { display: "flex"; gap: "0.25rem"; borderBottom: "1px solid var(--ui-border)"; overflowX: "auto"; scrollbarWidth: "none" }
  .ui-tabs__tab {
    position: "relative"
    font: "inherit"
    fontSize: "0.92rem"
    fontWeight: "550"
    color: "var(--ui-muted)"
    background: "transparent"
    border: "0"
    padding: "0.7rem 0.85rem"
    cursor: "pointer"
    whiteSpace: "nowrap"
    borderRadius: "8px 8px 0 0"
    transition: "color 0.15s"
    &:hover { color: "var(--ui-text)" }
    &::after { content: "''"; position: "absolute"; left: "0.6rem"; right: "0.6rem"; bottom: "-1px"; height: "2px"; borderRadius: "2px"; background: "transparent"; transition: "background-color 0.15s" }
    &[aria-selected="true"] { color: "var(--ui-text)" }
    &[aria-selected="true"]::after { background: "var(--ui-accent)" }
    &:focus-visible { outline: "none"; boxShadow: "inset var(--ui-ring)" }
  }
  .ui-tabs__panel { paddingTop: "1.1rem" }
  .ui-tabs__panel:focus-visible { outline: "none" }
  .ui-tabs__panel > * { display: "none" }
  .ui-tabs__panel[data-selected="0"] > :nth-child(1) { display: "block" }
  .ui-tabs__panel[data-selected="1"] > :nth-child(2) { display: "block" }
  .ui-tabs__panel[data-selected="2"] > :nth-child(3) { display: "block" }
  .ui-tabs__panel[data-selected="3"] > :nth-child(4) { display: "block" }
  .ui-tabs__panel[data-selected="4"] > :nth-child(5) { display: "block" }
  .ui-tabs__panel[data-selected="5"] > :nth-child(6) { display: "block" }
  .ui-tabs__panel[data-selected="6"] > :nth-child(7) { display: "block" }
  .ui-tabs__panel[data-selected="7"] > :nth-child(8) { display: "block" }

  .ui-accordion { borderBottom: "1px solid var(--ui-border)" }
  .ui-accordion__summary {
    display: "flex"
    alignItems: "center"
    justifyContent: "space-between"
    gap: "1rem"
    padding: "1rem 0"
    fontWeight: "600"
    cursor: "pointer"
    listStyle: "none"
    &::-webkit-details-marker { display: "none" }
    &::after { content: "''"; width: "0.5rem"; height: "0.5rem"; borderRight: "1.5px solid var(--ui-muted)"; borderBottom: "1.5px solid var(--ui-muted)"; transform: "rotate(45deg) translate(-2px, -2px)"; transition: "transform 0.2s var(--ui-ease)" }
  }
  .ui-accordion[open] > .ui-accordion__summary::after { transform: "rotate(-135deg) translate(-2px, -2px)" }
  .ui-accordion__body { paddingBottom: "1rem"; color: "color-mix(in srgb, var(--ui-text) 85%, transparent)" }

  .ui-tooltip { position: "relative"; display: "inline-flex" }
  .ui-tooltip__bubble {
    position: "absolute"
    left: "50%"
    bottom: "calc(100% + 8px)"
    transform: "translate(-50%, 2px)"
    zIndex: "50"
    padding: "0.35rem 0.6rem"
    borderRadius: "8px"
    background: "var(--ui-text)"
    color: "var(--ui-bg)"
    fontSize: "0.78rem"
    fontWeight: "500"
    lineHeight: "1.3"
    whiteSpace: "nowrap"
    pointerEvents: "none"
    opacity: "0"
    visibility: "hidden"
    transition: "opacity 0.15s var(--ui-ease), transform 0.15s var(--ui-ease)"
  }
  .ui-tooltip--bottom .ui-tooltip__bubble { bottom: "auto"; top: "calc(100% + 8px)"; transform: "translate(-50%, -2px)" }
  .ui-tooltip:hover .ui-tooltip__bubble, .ui-tooltip:focus-within .ui-tooltip__bubble { opacity: "1"; visibility: "visible"; transform: "translate(-50%, 0)" }

  .ui-table__wrap { overflowX: "auto"; border: "1px solid var(--ui-border)"; borderRadius: "var(--ui-radius-lg)"; background: "var(--ui-elevated)" }
  .ui-table { width: "100%"; borderCollapse: "collapse"; fontSize: "0.92rem" }
  .ui-table th, .ui-table td { padding: "0.7rem 1rem"; textAlign: "start"; borderBottom: "1px solid var(--ui-border)" }
  .ui-table th { fontSize: "0.82rem"; fontWeight: "600"; color: "var(--ui-muted)"; whiteSpace: "nowrap"; background: "var(--ui-surface)" }
  .ui-table tbody tr { transition: "background-color 0.1s" }
  .ui-table tbody tr:hover td { background: "color-mix(in srgb, var(--ui-accent) 5%, transparent)" }
  .ui-table tbody tr:last-child td { borderBottom: "0" }
  .ui-table--striped tbody tr:nth-child(even) td { background: "color-mix(in srgb, var(--ui-surface) 70%, transparent)" }
  .ui-table .ui-table__num { textAlign: "end"; fontVariantNumeric: "tabular-nums" }
  .ui-table__caption { captionSide: "top"; textAlign: "start"; padding: "0.85rem 1rem"; fontWeight: "650" }
  .ui-table__sort { display: "inline-flex"; alignItems: "center"; gap: "0.35rem"; font: "inherit"; color: "inherit"; background: "none"; border: "0"; padding: "0"; cursor: "pointer"; &:hover { color: "var(--ui-text)" } }
  .ui-table__arrow { width: "0.4rem"; height: "0.4rem"; borderRight: "1.5px solid currentColor"; borderBottom: "1.5px solid currentColor"; transform: "rotate(45deg) translateY(-2px)"; opacity: "0.3"; transition: "transform 0.15s, opacity 0.15s" }
  .ui-table__arrow--on { opacity: "1"; transform: "rotate(-135deg) translateY(-1px)" }
  .ui-table__arrow--on.ui-table__arrow--desc { transform: "rotate(45deg) translateY(-2px)" }
  .ui-table__empty { textAlign: "center"; color: "var(--ui-muted)"; padding: "2rem" }

  .ui-pagination { display: "flex"; alignItems: "center"; gap: "0.25rem"; flexWrap: "wrap" }
  .ui-pagination__item {
    display: "inline-flex"
    alignItems: "center"
    justifyContent: "center"
    minWidth: "2.25rem"
    height: "2.25rem"
    padding: "0 0.6rem"
    font: "inherit"
    fontSize: "0.9rem"
    fontVariantNumeric: "tabular-nums"
    border: "1px solid transparent"
    borderRadius: "var(--ui-radius)"
    background: "transparent"
    color: "var(--ui-text)"
    cursor: "pointer"
    transition: "background-color 0.15s"
    & svg { fill: "none"; stroke: "currentColor"; strokeWidth: "1.6"; strokeLinecap: "round"; strokeLinejoin: "round" }
    &:hover:not(:disabled) { background: "var(--ui-surface-2)" }
    &:disabled { opacity: "0.35"; cursor: "not-allowed" }
    &[aria-current="page"] { background: "var(--ui-accent)"; color: "var(--ui-accent-text)"; fontWeight: "600" }
  }
  .ui-pagination__gap { color: "var(--ui-muted)"; padding: "0 0.25rem" }

  .ui-breadcrumbs ol { display: "flex"; flexWrap: "wrap"; alignItems: "center"; gap: "0.45rem"; listStyle: "none"; margin: "0"; padding: "0"; fontSize: "0.88rem" }
  .ui-breadcrumbs li { display: "flex"; alignItems: "center"; gap: "0.45rem"; color: "var(--ui-muted)" }
  .ui-breadcrumbs li + li::before { content: "''"; width: "0.35rem"; height: "0.35rem"; borderRight: "1.5px solid var(--ui-border-strong)"; borderTop: "1.5px solid var(--ui-border-strong)"; transform: "rotate(45deg)" }
  .ui-breadcrumbs a { color: "var(--ui-muted)"; textDecoration: "none"; &:hover { color: "var(--ui-text)" } }
  .ui-breadcrumbs [aria-current] { color: "var(--ui-text)"; fontWeight: "550" }

  .ui-progress { height: "0.4rem"; background: "var(--ui-surface-2)"; borderRadius: "999px"; overflow: "hidden" }
  .ui-progress__bar { height: "100%"; background: "var(--ui-accent)"; borderRadius: "inherit"; transition: "width 0.3s var(--ui-ease)" }
  .ui-progress--indeterminate .ui-progress__bar { animation: "ui-indeterminate 1.2s ease-in-out infinite" }
  @keyframes ui-indeterminate { from { transform: "translateX(-100%)" } to { transform: "translateX(250%)" } }

  .ui-skeleton {
    display: "block"
    background: "linear-gradient(90deg, var(--ui-surface-2) 25%, var(--ui-surface) 50%, var(--ui-surface-2) 75%)"
    backgroundSize: "200% 100%"
    animation: "ui-shimmer 1.4s linear infinite"
  }
  @keyframes ui-shimmer { from { backgroundPosition: "200% 0" } to { backgroundPosition: "-200% 0" } }

  .ui-empty { display: "flex"; flexDirection: "column"; alignItems: "center"; gap: "0.5rem"; textAlign: "center"; padding: "3rem 1.25rem"; border: "1px dashed var(--ui-border-strong)"; borderRadius: "var(--ui-radius-lg)" }
  .ui-empty__title { fontSize: "1.05rem"; fontWeight: "650" }
  .ui-empty__description { margin: "0 0 0.5rem"; color: "var(--ui-muted)"; maxWidth: "36rem" }

  .ui-dropdown { position: "relative"; display: "inline-block" }
  .ui-dropdown__caret { fill: "none"; stroke: "currentColor"; strokeWidth: "1.8"; strokeLinecap: "round"; strokeLinejoin: "round"; opacity: "0.7"; transition: "transform 0.15s var(--ui-ease)" }
  .ui-dropdown__trigger[aria-expanded="true"] .ui-dropdown__caret { transform: "rotate(180deg)" }
  .ui-dropdown__menu {
    position: "absolute"
    top: "calc(100% + 6px)"
    left: "0"
    zIndex: "60"
    minWidth: "13rem"
    display: "flex"
    flexDirection: "column"
    padding: "0.35rem"
    background: "var(--ui-elevated)"
    border: "1px solid var(--ui-border)"
    borderRadius: "12px"
    boxShadow: "var(--ui-shadow-lg)"
    animation: "ui-pop 0.14s var(--ui-ease)"
  }
  .ui-dropdown__menu--end { left: "auto"; right: "0" }
  .ui-dropdown__menu > a, .ui-dropdown__menu > button {
    display: "flex"
    alignItems: "center"
    gap: "0.5rem"
    height: "2.1rem"
    padding: "0 0.7rem"
    font: "inherit"
    fontSize: "0.92rem"
    textAlign: "start"
    color: "var(--ui-text)"
    background: "none"
    border: "0"
    borderRadius: "8px"
    textDecoration: "none"
    cursor: "pointer"
    &:hover, &:focus-visible { background: "color-mix(in srgb, var(--ui-accent) 12%, transparent)"; outline: "none" }
  }
  .ui-dropdown__menu > hr { border: "0"; borderTop: "1px solid var(--ui-border)"; margin: "0.3rem 0.2rem" }
  @keyframes ui-pop { from { opacity: "0"; transform: "translateY(-4px) scale(0.98)" } }

  .ui-toaster { position: "fixed"; zIndex: "1100"; display: "flex"; flexDirection: "column"; gap: "0.5rem"; padding: "1rem"; width: "min(24rem, 100vw)"; pointerEvents: "none" }
  .ui-toaster--bottom-end { right: "0"; bottom: "0" }
  .ui-toaster--bottom-start { left: "0"; bottom: "0" }
  .ui-toaster--top-end { right: "0"; top: "0" }
  .ui-toaster--top-start { left: "0"; top: "0" }
  .ui-toast {
    --ui-tone: "var(--ui-info)"
    pointerEvents: "auto"
    display: "flex"
    alignItems: "center"
    gap: "0.7rem"
    padding: "0.6rem 0.5rem 0.6rem 0.95rem"
    background: "color-mix(in srgb, var(--ui-elevated) 92%, transparent)"
    backdropFilter: "blur(12px) saturate(1.4)"
    border: "1px solid var(--ui-border)"
    borderRadius: "14px"
    boxShadow: "var(--ui-shadow-lg)"
    fontSize: "0.92rem"
    animation: "ui-toast-in 0.25s var(--ui-ease)"
  }
  .ui-toast--success { --ui-tone: "var(--ui-success)" }
  .ui-toast--warning { --ui-tone: "var(--ui-warning)" }
  .ui-toast--danger { --ui-tone: "var(--ui-danger)" }
  .ui-toast__dot { width: "0.5rem"; height: "0.5rem"; flexShrink: "0"; borderRadius: "50%"; background: "var(--ui-tone)"; boxShadow: "0 0 0 3px color-mix(in srgb, var(--ui-tone) 20%, transparent)" }
  .ui-toast__message { flex: "1"; minWidth: "0" }
  .ui-toast__close { width: "1.75rem"; height: "1.75rem" }
  @keyframes ui-toast-in { from { opacity: "0"; transform: "translateY(8px) scale(0.98)" } }

  .ui-kbd {
    display: "inline-flex"
    alignItems: "center"
    minWidth: "1.5em"
    justifyContent: "center"
    padding: "0.1rem 0.4rem"
    fontFamily: "var(--ui-font)"
    fontSize: "0.78em"
    fontWeight: "550"
    border: "1px solid var(--ui-border-strong)"
    borderBottomWidth: "2px"
    borderRadius: "6px"
    background: "var(--ui-surface)"
    color: "var(--ui-muted)"
  }

  .ui-avatar { borderRadius: "50%"; objectFit: "cover"; flexShrink: "0"; boxShadow: "0 0 0 1px var(--ui-border)" }
  .ui-avatar--initials {
    display: "inline-flex"
    alignItems: "center"
    justifyContent: "center"
    background: "color-mix(in srgb, var(--ui-accent) 16%, var(--ui-surface))"
    color: "var(--ui-accent)"
    fontWeight: "650"
    fontSize: "0.85em"
    letterSpacing: "0.02em"
  }

  .ui-spinner {
    display: "inline-block"
    flexShrink: "0"
    borderRadius: "50%"
    border: "2px solid color-mix(in srgb, var(--ui-accent) 22%, transparent)"
    borderTopColor: "var(--ui-accent)"
    animation: "ui-spin 0.7s linear infinite"
  }
  .ui-spinner--inline { width: "1em"; height: "1em"; borderColor: "color-mix(in srgb, currentColor 30%, transparent)"; borderTopColor: "currentColor" }
  @keyframes ui-spin { to { transform: "rotate(360deg)" } }

  .ui-navbar {
    position: "sticky"
    top: "0"
    zIndex: "100"
    background: "color-mix(in srgb, var(--ui-bg) 80%, transparent)"
    backdropFilter: "saturate(1.6) blur(14px)"
    borderBottom: "1px solid var(--ui-border)"
  }
  .ui-navbar__inner { maxWidth: "72rem"; margin: "0 auto"; padding: "0 clamp(1rem, 4vw, 2rem)"; height: "3.75rem"; display: "flex"; alignItems: "center"; gap: "1.5rem" }
  .ui-navbar__brand { fontWeight: "700"; fontSize: "1.05rem"; letterSpacing: "-0.02em"; color: "var(--ui-text)"; textDecoration: "none" }
  .ui-navbar__links { display: "flex"; alignItems: "center"; gap: "0.25rem"; marginLeft: "auto"; flexWrap: "wrap" }
  .ui-navbar__links a { padding: "0.4rem 0.7rem"; borderRadius: "8px"; color: "var(--ui-muted)"; textDecoration: "none"; fontSize: "0.92rem"; fontWeight: "500"; transition: "color 0.15s, background-color 0.15s" }
  .ui-navbar__links a:hover { color: "var(--ui-text)"; background: "var(--ui-surface)" }
  .ui-navbar__links a[aria-current="page"] { color: "var(--ui-text)" }

  .ui-divider { border: "0"; borderTop: "1px solid var(--ui-border)"; margin: "1.75rem 0" }
  .ui-divider--label {
    display: "flex"
    alignItems: "center"
    gap: "0.75rem"
    color: "var(--ui-muted)"
    fontSize: "0.82rem"
    borderTop: "0"
    &::before, &::after { content: "''"; flex: "1"; borderTop: "1px solid var(--ui-border)" }
  }

  reducedMotion {
    .ui-spinner { animationDuration: "2s" }
    .ui-skeleton, .ui-progress--indeterminate .ui-progress__bar, .ui-toast, .ui-dropdown__menu { animation: "none" }
    .ui-btn, .ui-card--interactive, .ui-modal, .ui-modal__dialog, .ui-progress__bar, .ui-toggle__thumb, .ui-toggle__track, .ui-tooltip__bubble { transition: "none" }
  }
}
