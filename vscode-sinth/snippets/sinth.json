{
  "Page": {
    "prefix": "page",
    "body": ["title = \"${1:Title}\"", "descr = \"${2:Description}\"", "", "Main {", "  Heading(level: 1) { \"${1:Title}\" }", "  $0", "}"],
    "description": "New page"
  },
  "Component": {
    "prefix": "component",
    "body": ["component ${1:Name}(str ${2:title}) {", "  Div(class: \"${3:box}\") {", "    Heading(level: 3) { ${2:title} }", "    \\$slot", "  }", "", "  style {", "    .${3:box} {", "      padding: \"1rem\"", "    }", "  }", "}"],
    "description": "Component with a slot and scoped styles"
  },
  "Function": {
    "prefix": "function",
    "body": ["function ${1:name}(${2:num value}) -> ${3:num} {", "  return ${0:value}", "}"],
    "description": "Typed function"
  },
  "UI function": {
    "prefix": "uifunction",
    "body": ["function ${1:name}(${2:str label}) -> ui {", "  ${3:Span} { ${4:label} }", "}"],
    "description": "Function that renders markup"
  },
  "If": {
    "prefix": "if",
    "body": ["if ${1:condition} {", "  $0", "}"],
    "description": "Conditional"
  },
  "If else": {
    "prefix": "ifelse",
    "body": ["if ${1:condition} {", "  $2", "} else {", "  $0", "}"],
    "description": "Conditional with else"
  },
  "For": {
    "prefix": "for",
    "body": ["for ${1:item} in ${2:items} {", "  $0", "}"],
    "description": "Loop"
  },
  "For keyed": {
    "prefix": "forkey",
    "body": ["for ${1:item}, ${2:index} in ${3:items} key ${1:item}.${4:id} {", "  $0", "} else {", "  Paragraph { \"${5:Nothing here yet.}\" }", "}"],
    "description": "Keyed loop with index and empty state"
  },
  "Variable": {
    "prefix": "var",
    "body": ["var ${1|str,num,bool,obj,str[],num[],obj[]|} ${2:name} = ${0}"],
    "description": "Reactive variable"
  },
  "Computed": {
    "prefix": "computed",
    "body": ["computed ${1|num,str,bool|} ${2:name} = ${0}"],
    "description": "Derived value"
  },
  "Counter": {
    "prefix": "counter",
    "body": ["var num ${1:count} = 0", "", "Button(onClick: ${1:count} += 1) { \"Clicked \" + ${1:count} + \" times\" }"],
    "description": "Reactive counter"
  },
  "Form": {
    "prefix": "form",
    "body": ["var str ${1:email} = \"\"", "", "function submit() {", "  $0", "}", "", "Form(onSubmit.prevent: submit()) {", "  Input(type: \"email\", model: ${1:email}, required)", "  SubmitButton { \"Send\" }", "}"],
    "description": "Form with binding and submit handler"
  },
  "Fetch on mount": {
    "prefix": "fetch",
    "body": ["var obj[] ${1:items} = []", "var bool loading = true", "", "onMount {", "  const res = await fetch(\"${2:/api/items}\")", "  ${1:items} = await res.json()", "  loading = false", "}"],
    "description": "Load data when the page opens"
  },
  "Watch": {
    "prefix": "watch",
    "body": ["watch ${1:value} {", "  $0", "}"],
    "description": "Run code when a value changes"
  },
  "Import": {
    "prefix": "import",
    "body": ["import { ${1:Name} } from \"${2:./components/${1:Name}.sinth}\""],
    "description": "Import from a Sinth file"
  },
  "Import sinth:ui": {
    "prefix": "importui",
    "body": ["import { ${1:Button, Card} } from \"sinth:ui\""],
    "description": "Import from the built-in component library"
  },
  "Style": {
    "prefix": "style",
    "body": ["style {", "  ${1:main} {", "    $0", "  }", "}"],
    "description": "Style block"
  },
  "Script": {
    "prefix": "script",
    "body": ["script {", "  $0", "}"],
    "description": "JavaScript block"
  },
  "Custom element": {
    "prefix": "element",
    "body": ["component ${1:Widget}(${2:str label = \"Hi\"}) as <${3:my-widget}> {", "  $0", "}"],
    "description": "Component exported as a custom HTML element"
  }
}
