{
  "name": "sinth-vscode",
  "displayName": "Sinth",
  "description": "Official Sinth 5 language support: syntax highlighting, IntelliSense, diagnostics, formatting and commands.",
  "version": "5.2.1",
  "publisher": "YannosayProductions",
  "author": "Yannosay Productions",
  "license": "AGPL-3.0",
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#0A0A0B",
    "theme": "dark"
  },
  "homepage": "https://github.com/Yannosay/sinth#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Yannosay/sinth.git",
    "directory": "vscode-sinth"
  },
  "bugs": {
    "url": "https://github.com/Yannosay/sinth/issues"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "sinth",
    "web",
    "ui",
    "reactive",
    "components",
    "static site",
    "html",
    "css",
    "intellisense"
  ],
  "activationEvents": [
    "workspaceContains:**/*.sinth",
    "workspaceContains:sinth.config.json"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "sinth",
        "aliases": [
          "Sinth",
          "sinth"
        ],
        "extensions": [
          ".sinth"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./assets/file-icon.png",
          "dark": "./assets/file-icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "sinth",
        "scopeName": "source.sinth",
        "path": "./syntaxes/sinth.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.javascript.sinth": "javascript",
          "meta.embedded.block.style.sinth": "css"
        }
      }
    ],
    "snippets": [
      {
        "language": "sinth",
        "path": "./snippets/sinth.json"
      }
    ],
    "commands": [
      {
        "command": "sinth.dev",
        "title": "Start Dev Server",
        "category": "Sinth"
      },
      {
        "command": "sinth.build",
        "title": "Build for Production",
        "category": "Sinth"
      },
      {
        "command": "sinth.preview",
        "title": "Preview Production Build",
        "category": "Sinth"
      },
      {
        "command": "sinth.check",
        "title": "Check Project for Errors",
        "category": "Sinth"
      },
      {
        "command": "sinth.deploy",
        "title": "Deploy to Cloudflare Pages",
        "category": "Sinth"
      },
      {
        "command": "sinth.newPage",
        "title": "New Page",
        "category": "Sinth"
      },
      {
        "command": "sinth.newComponent",
        "title": "New Component",
        "category": "Sinth"
      },
      {
        "command": "sinth.openDocs",
        "title": "Open Documentation",
        "category": "Sinth"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "sinth.dev",
          "when": "resourceLangId == sinth",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Sinth",
      "properties": {
        "sinth.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Check Sinth files with `sinth check` when they are opened and saved."
        },
        "sinth.compilerPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the Sinth CLI (`bin/sinth.js` or an executable). Empty: use the project's `node_modules/@yannosay/sinth`, then a global `sinth`."
        }
      }
    },
    "configurationDefaults": {
      "[sinth]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.defaultFormatter": "YannosayProductions.sinth-vscode"
      }
    },
    "jsonValidation": [
      {
        "fileMatch": "sinth.config.json",
        "url": "./schema/sinth.config.schema.json"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "vscode:prepublish": "npm run compile",
    "test": "npm run compile && node ./out/test/runTests.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "1.80.0",
    "@types/mocha": "^10.0.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.0",
    "mocha": "^10.7.0",
    "typescript": "^5.6.0"
  }
}
